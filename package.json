{
    "name": "ipyauth",
    "version": "0.2.7",
    "description": "A Custom Jupyter Widget Library",
    "author": "oscar6echo",
    "license": "MIT",
    "main": "dist/index.js",
    "repository": {
        "type": "git",
        "url": "https://gitlab.com/oscar6echo/ipyauth.git"
    },
    "keywords": [
        "jupyter",
        "widgets",
        "ipython",
        "ipywidgets",
        "oauth2",
        "implicit flow",
        "Auth0",
        "Google",
        "SG Connect",
        "Keycloak"
    ],
    "files": [
        "ipyauth/js/src/**/*.js",
        "ipyauth/js/dist/*.js",
        "ipyauth/js/src/styles/**/*.css",
        "ipyauth/js/src/styles/icons/*.svg"
    ],
    "jupyterlab": {
        "extension": "src/labplugin",
        "outputDir": "./ipyauth/labextension",
        "sharedPackages": {
            "@jupyter-widgets/base": {
                "bundled": false,
                "singleton": true
            }
        }
    },
    "scripts": {
        "clean": "rimraf dist/ && rimraf ../ipyauth_widget/static/",
        "cleanall": "npm run clean && rimraf node_modules/",
        "prepare-dev": "webpack --mode development",
        "prepare": "webpack --mode production",
        "watch": "watch 'npm run prepare-dev' src/",
        "test": "echo \"Error: no test specified\" && exit 1",
        "lint": "eslint '**/*.js' --quiet",
        "format": "prettier --write '**/*.js'",
        "build": "webpack --mode=production && npm run build:labextension",
        "build:labextension": "jupyter labextension build .",
        "build:labextension:dev": "jupyter labextension build --development True ."
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@babel/preset-env": "^7.24.0",
        "@babel/preset-react": "^7.23.3",
        "babel-core": "^4.7.16",
        "babel-loader": "^9.1.3",
        "babel-preset-env": "^1.7.0",
        "css-loader": "^6.10.0",
        "eslint": "^8.57.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-html": "^8.0.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-react": "^7.34.0",
        "json-loader": "^0.5.7",
        "less": "^4.2.0",
        "less-loader": "^12.2.0",
        "prettier": "^3.2.5",
        "rimraf": "^5.0.5",
        "style-loader": "^3.3.4",
        "watch": "^0.13.0",
        "webpack": "^5.90.3",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "@jupyter-widgets/base": "^6.0.7",
        "@jupyter-widgets/controls": "^5.0.8",
        "axios": "^1.6.7",
        "lodash": "^4.17.21"
    }
}
